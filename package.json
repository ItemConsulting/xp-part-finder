{
  "name": "@itemconsulting/xp-part-finder",
  "description": "Part finder",
  "version": "2.0.0",
  "homepage": "https://github.com/ItemConsulting/xp-part-finder",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/part-finder"
  },
  "scripts": {
    "clean": "rimraf build",
    "designsystemet": "designsystemet",
    "build": "concurrently -c auto -g --timings npm:build:*",
    "build:postcss": "npx postcss src/main/resources/assets/styles/main.css -m -d build/resources/main/assets --base src/main/resources/assets --ext min.css",
    "build:server": "tsdown",
    "watch": "concurrently -c auto npm:watch:*",
    "watch:postcss": "npm run build:postcss -- --watch",
    "watch:server": "tsdown --watch",
    "check": "concurrently -c auto -g --timings npm:lint npm:check:types",
    "check:types": "concurrently -g -r --timings npm:check:types:*",
    "check:types:server": "npx tsc --noEmit -p src/main/resources/tsconfig.json",
    "check:types:build": "npx tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "changeset publish",
    "versioning": "changeset version && npm i --package-lock-only && node .changeset/gradle-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "^3.0.3",
    "@digdir/designsystemet": "^1.24.1",
    "@enonic-types/core": "8.1.0",
    "@enonic-types/global": "8.1.0",
    "@enonic-types/lib-admin": "8.1.0",
    "@enonic-types/lib-app": "8.1.0",
    "@enonic-types/lib-asset": "^2.0.1",
    "@enonic-types/lib-auth": "8.1.0",
    "@enonic-types/lib-content": "8.1.0",
    "@enonic-types/lib-context": "8.1.0",
    "@enonic-types/lib-i18n": "8.1.0",
    "@enonic-types/lib-node": "8.1.0",
    "@enonic-types/lib-project": "8.1.0",
    "@enonic-types/lib-schema": "8.1.0",
    "@item-enonic-types/lib-freemarker": "^4.0.0",
    "@item-enonic-types/lib-time": "^2.0.0",
    "@itemconsulting/storybook-framework-enonic-xp": "^1.0.0-beta.0",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-links": "^10.6.9",
    "@storybook/server": "^10.6.9",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.0",
    "addon-storybook-sync": "0.1.0",
    "concurrently": "^10",
    "cssnano": "^9.9.0",
    "postcss": "^8.5.33",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-url": "^10.1.4",
    "rimraf": "^6",
    "storybook": "^10.6.9",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "storybook": "$storybook"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.24.1",
    "@digdir/designsystemet-web": "^1.24.1"
  }
}
