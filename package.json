{
  "name": "@itemconsulting/xp-part-finder",
  "description": "Part finder",
  "version": "1.2.0",
  "homepage": "https://github.com/ItemConsulting/xp-part-finder",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/part-finder"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "concurrently -c auto -g --timings npm:build:*",
    "build:postcss": "npx postcss src/main/resources/assets/styles/main.css -m -d build/resources/main/assets --base src/main/resources/assets --ext min.css",
    "build:server": "npx tsup -d build/resources/main",
    "watch": "concurrently -c auto npm:watch:*",
    "watch:postcss": "npm run build:postcss -- --watch",
    "watch:server": "npm run build:server -- --watch",
    "check": "concurrently -c auto -g --timings npm:lint npm:check:types",
    "check:types": "concurrently -g -r --timings npm:check:types:*",
    "check:types:server": "npx tsc --noEmit -p src/main/resources/tsconfig.json",
    "check:types:build": "npx tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "npm run build",
    "versioning": "npx changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i \"s/version.*/version = ${NEW_VERSION}/\" gradle.properties"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "^3.0.3",
    "@enonic-types/core": "^7.12.0",
    "@enonic-types/global": "^7.12.0",
    "@enonic-types/lib-admin": "^7.12.0",
    "@enonic-types/lib-app": "^7.12.0",
    "@enonic-types/lib-asset": "^1.0.3",
    "@enonic-types/lib-auth": "^7.12.0",
    "@enonic-types/lib-content": "^7.12.0",
    "@enonic-types/lib-context": "^7.12.0",
    "@enonic-types/lib-i18n": "^7.12.0",
    "@enonic-types/lib-node": "^7.12.0",
    "@enonic-types/lib-project": "^7.12.0",
    "@enonic-types/lib-schema": "^7.12.0",
    "@item-enonic-types/lib-freemarker": "^3.0.0",
    "@item-enonic-types/lib-time": "^1.6.1",
    "@itemconsulting/preset-enonic-xp": "^0.5.0",
    "@itemconsulting/xp-storybook-utils": "^0.3.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-links": "^10.6.8",
    "@storybook/addon-styling-webpack": "^3.0.3",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.6",
    "@storybook/server-webpack5": "^10.6.8",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10",
    "cssnano": "^9.9.0",
    "glob": "^14.0.6",
    "postcss": "^8.5.33",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.2",
    "postcss-nesting": "^14.0.3",
    "postcss-normalize": "^13.0.1",
    "postcss-reporter": "^7.1.0",
    "postcss-url": "^10.1.4",
    "rimraf": "^6",
    "storybook": "^10.6.8",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
